{
  "name": "phantom",
  "version": "0.4.0",
  "description": "Phantom \u2014 a personal AI computer companion (voice-first). Coded, Health and specialist brains live inside the same platform.",
  "author": "g2code33",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/g2code33/PHANTOM-AI.git"
  },
  "scripts": {
    "web:build": "node scripts/build-web.js",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run web:build && npm run build:electron && electron .",
    "dist": "npm run web:build && npm run build:electron && electron-builder",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run web:build && npx cap sync android",
    "cap:assets": "npx capacitor-assets generate --android",
    "smoke": ".venv/bin/python -m pytest tests/ -q",
    "release:patch": "npm version patch --no-git-tag-version && git add -A && git commit -m \"release: v$(node -p \"require('./package.json').version\")\" && git push origin main"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.g2code33.phantom",
    "productName": "Phantom",
    "copyright": "Copyright \u00a9 2026 g2code33",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "ui/**/*",
      "phantom_ai/**/*",
      "pyproject.toml",
      "build/icon.png"
    ],
    "asarUnpack": [
      "dist/**/*",
      "build/**/*",
      "ui/**/*",
      "phantom_ai/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Phantom-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "g2code33",
      "synopsis": "Phantom personal AI companion",
      "executableName": "phantom",
      "description": "A personal AI computer companion \u2014 voice-first."
    },
    "deb": {
      "afterInstall": "build/after_install.sh",
      "artifactName": "phantom_${version}_amd64.${ext}",
      "afterRemove": "build/after_remove.sh"
    },
    "appImage": {
      "artifactName": "Phantom-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "g2code33",
      "repo": "PHANTOM-AI",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "dist-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}